\@writefile{toc}{\contentsline {subsection}{\numberline {3.1}Stasjonær fordeling og MaxEnt-konsistens}{10}{}\protected@file@percent }
\newlabel{eq:boltzmann}{{4}{10}{Stasjonær fordeling og MaxEnt-konsistens}{equation.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces \texorpdfstring {\xpg@aux {variant=nynorsk}{norwegian}}{}\ignorespaces Boltzmann-fordeling $P(F) \propto \exp (-\beta \hat  {\mathcal  {L}}(F))$ over eit to-dimensjonalt formrom, ved tre verdiar av den inverse temperaturen $\beta $. Låg $\beta $ (varmt) gjev brei spreiing over fleire haugar; høg $\beta $ (kaldt) konsentrerer sannsynet rundt dei globale toppane. $\beta $ tolkast som styrken av seleksjon i forhold til stokastisk variasjon.}}{10}{}\protected@file@percent }
\newlabel{fig:boltzmann}{{8}{10}{Stasjonær fordeling og MaxEnt-konsistens}{figure.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces \texorpdfstring {\xpg@aux {variant=nynorsk}{norwegian}}{}\ignorespaces Tre kandidatar til stasjonær fordeling. Boltzmann (venstre) har stramme halar og ein modus; Pareto (midten) har tunge halar og konsentrerer mest masse nær null; lognormal (høgre) er høgreskeiv med moderate halar. Formlære vel Boltzmann fordi han er MaxEnt-konsistent under éin avgrensing (kjent forventa $\mathcal  {L}$). Alternativa krev sterkare antakingar om den underliggjande fordelinga.}}{10}{}\protected@file@percent }
\newlabel{fig:alternativ}{{9}{10}{Stasjonær fordeling og MaxEnt-konsistens}{figure.9}{}}
