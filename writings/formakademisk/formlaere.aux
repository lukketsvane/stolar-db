\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \texorpdfstring {\xpg@aux {variant=nynorsk}{norwegian}}{}\ignorespaces Kanalisering etter \citet  {waddington1957}: brattleiken på dalveggane gjev robustheit mot forstyrring. Venstre: bratte kanalar held realiserte former nær eit lokalt optimum trass i varierande initialtilstand og påverknad. Høgre: grunne kanalar gjev drift og stor formvariasjon. Kanalisering er målbar og kan estimerast empirisk frå formdata.}}{7}{}\protected@file@percent }
\newlabel{fig:kanalisering}{{4}{7}{Tilpassingslandskap}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \texorpdfstring {\xpg@aux {variant=nynorsk}{norwegian}}{}\ignorespaces Tilpassingslandskap på ulike abstraksjonsskalaer. Kvar skala har sitt eige landskap med eigne tidsskalaer, frå mikrosekund på molekylnivå til hundreår på biosfære-nivå. Kjerne-likninga er skala-fri: same formelle struktur gjeld på alle nivå, men med ulike parameteriseringar. Dette er grunnlaget for den substrat-uavhengige koplinga i seksjon~4.}}{7}{}\protected@file@percent }
\newlabel{fig:multiskala}{{5}{7}{Tilpassingslandskap}{figure.5}{}}
